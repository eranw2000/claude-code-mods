<mxfile host="app.diagrams.net" agent="drawio_build">
  <diagram id="page-1" name="claude-code-mods flow">
    <mxGraphModel grid="0" page="1" pageWidth="3230" pageHeight="876">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="claude-code-mods: five live panes beside the conversation" style="text;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#0050b3;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="2640" height="60" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;green = when it happens&lt;br&gt;blue = what the mod does&lt;br&gt;orange = what you see&lt;br&gt;purple frame = helper-panel, the newest mod" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=15;html=1;" vertex="1" parent="1"><mxGeometry x="2710" y="20" width="480" height="122" as="geometry"/></mxCell>
        <mxCell id="agents" value="Agents pane: what every helper is doing" style="rounded=0;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;whiteSpace=wrap;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="600" height="545" as="geometry"/></mxCell>
        <mxCell id="agents-when" value="A helper agent, a background command or a Codex run starts, or you send your first prompt" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;fontSize=15;spacingLeft=60;spacingRight=60;html=1;" vertex="1" parent="agents"><mxGeometry x="30" y="56" width="540" height="133" as="geometry"/></mxCell>
        <mxCell id="agents-mod" value="&lt;b&gt;agents-panel&lt;/b&gt; follows each helper&#x27;s tool calls, plan steps, tokens and time, and every shell command of the session" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="agents"><mxGeometry x="30" y="245" width="540" height="93" as="geometry"/></mxCell>
        <mxCell id="agents-see" value="&lt;b&gt;Agents tab&lt;/b&gt;: one card per helper, each with its own pixel crab; a progress bar with time left; what the main loop is doing; the shell commands" style="shape=document;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="agents"><mxGeometry x="30" y="394" width="540" height="121" as="geometry"/></mxCell>
        <mxCell id="thread" value="Thread pane: your prompts, a click away" style="rounded=0;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;whiteSpace=wrap;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="670" y="190" width="600" height="545" as="geometry"/></mxCell>
        <mxCell id="thread-when" value="You send a prompt" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;fontSize=15;spacingLeft=60;spacingRight=60;html=1;" vertex="1" parent="thread"><mxGeometry x="30" y="56" width="540" height="133" as="geometry"/></mxCell>
        <mxCell id="thread-mod" value="&lt;b&gt;thread-panel&lt;/b&gt; keeps each prompt you typed, adds the first paragraph of Claude&#x27;s answer under it, and notes where the prompt sits in the conversation" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="thread"><mxGeometry x="30" y="245" width="540" height="93" as="geometry"/></mxCell>
        <mxCell id="thread-see" value="&lt;b&gt;Thread tab&lt;/b&gt;: your prompts, oldest first, each with its answer&#x27;s first paragraph. Click a prompt to scroll the conversation to it" style="shape=document;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="thread"><mxGeometry x="30" y="394" width="540" height="121" as="geometry"/></mxCell>
        <mxCell id="files" value="Files pane: every file the session touches" style="rounded=0;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;whiteSpace=wrap;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="1310" y="190" width="600" height="545" as="geometry"/></mxCell>
        <mxCell id="files-when" value="Claude reads, edits or writes a file" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;fontSize=15;spacingLeft=60;spacingRight=60;html=1;" vertex="1" parent="files"><mxGeometry x="30" y="56" width="540" height="133" as="geometry"/></mxCell>
        <mxCell id="files-mod" value="&lt;b&gt;files-panel&lt;/b&gt; records each file and what is happening to it, and asks git whether it is committed" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="files"><mxGeometry x="30" y="245" width="540" height="93" as="geometry"/></mxCell>
        <mxCell id="files-see" value="&lt;b&gt;Files tab&lt;/b&gt;: the session&#x27;s files as a tree; files outside the project folder are folded under their own heading" style="shape=document;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="files"><mxGeometry x="30" y="394" width="540" height="121" as="geometry"/></mxCell>
        <mxCell id="usage" value="Usage pane: your account and your limits" style="rounded=0;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;whiteSpace=wrap;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="1950" y="190" width="600" height="545" as="geometry"/></mxCell>
        <mxCell id="usage-when" value="You send your first prompt, and each answer that follows" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;fontSize=15;spacingLeft=60;spacingRight=60;html=1;" vertex="1" parent="usage"><mxGeometry x="30" y="56" width="540" height="133" as="geometry"/></mxCell>
        <mxCell id="usage-mod" value="&lt;b&gt;usage-panel&lt;/b&gt; takes your limits from each answer, and your email and plan from your login record on this machine" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="usage"><mxGeometry x="30" y="245" width="540" height="93" as="geometry"/></mxCell>
        <mxCell id="usage-see" value="&lt;b&gt;Usage tab&lt;/b&gt;: your email and plan, and each limit with a bar, how much is used and when it resets" style="shape=document;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="usage"><mxGeometry x="30" y="394" width="540" height="121" as="geometry"/></mxCell>
        <mxCell id="helper" value="Helper pane (new mod): side questions and side jobs" style="rounded=0;fillColor=#f7f2fa;strokeColor=#9673a6;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;whiteSpace=wrap;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="2590" y="190" width="600" height="545" as="geometry"/></mxCell>
        <mxCell id="helper-when" value="You type a line in the pane, or press Do it" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;fontSize=15;spacingLeft=60;spacingRight=60;html=1;" vertex="1" parent="helper"><mxGeometry x="30" y="56" width="540" height="133" as="geometry"/></mxCell>
        <mxCell id="helper-mod" value="&lt;b&gt;helper-panel&lt;/b&gt; answers from the conversation so far, with no tools. For work, it starts a background helper with the session&#x27;s tools and permission rules" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="helper"><mxGeometry x="30" y="245" width="540" height="93" as="geometry"/></mxCell>
        <mxCell id="helper-see" value="&lt;b&gt;Helper tab&lt;/b&gt;: the answer or the helper&#x27;s report, out of the chat, with a &lt;b&gt;Do it&lt;/b&gt; button when you asked for work" style="shape=document;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;fontSize=15;html=1;" vertex="1" parent="helper"><mxGeometry x="30" y="394" width="540" height="121" as="geometry"/></mxCell>
        <mxCell id="band" value="&lt;b&gt;How the panes appear&lt;/b&gt;&lt;br&gt;The five panes sit side by side as tabs in one dock. Helper opens when a session starts. Agents, Thread, Files and Usage each open by themselves with your first prompt, and Agents also when a helper starts. &lt;b&gt;/agents-panel&lt;/b&gt;, &lt;b&gt;/thread-panel&lt;/b&gt;, &lt;b&gt;/files-panel&lt;/b&gt;, &lt;b&gt;/usage-panel&lt;/b&gt; and &lt;b&gt;/helper-panel&lt;/b&gt; open them by hand, and each mod is installed on its own and has its own on/off switch in &lt;b&gt;/config&lt;/b&gt;." style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=15;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="775" width="3160" height="61" as="geometry"/></mxCell>
        <mxCell id="agents-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="agents-when" target="agents-mod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="agents-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="agents-mod" target="agents-see"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
